#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
node tools/export-reference.mjs
node tools/export-surfaces.mjs
node tools/export-uniforms.mjs
node tools/export-lexer.mjs
node tools/export-parser.mjs
