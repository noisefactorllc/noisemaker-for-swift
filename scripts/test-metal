#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
# Run only on a native Metal host. Missing devices fail; no skip is a pass.
if [ -z "${NM_REFERENCE_EXPORT:-}" ]; then
    node tools/export-reference.mjs
elif [ ! -f "$NM_REFERENCE_EXPORT/source-manifest.json" ]; then
    echo "NM_REFERENCE_EXPORT must contain a locked source export" >&2
    exit 1
fi
python3 tools/build-tint.py
swift test --filter TranslatorGPUTests
